node_modules/
dist/
coverage/
.DS_Store
*.log

# ...but the vendored @lastdb/app-sdk IS distributed as its prebuilt dist/ — it
# has no source build step in this repo, so its dist/ must be committed. Without
# this negation the global `dist/` rule above silently drops the SDK's only
# runtime code, leaving the `@lastdb/app-sdk` tsconfig path alias an empty shell.
!/vendor/lastdb-app-sdk/dist/

# Generated operational output stays outside Git (Tom, 2026-10-23).
/.evidence/
/.benchmark-output/
/benchmark-results/
/bench-results/
/.portal-worktree
**/__pycache__/
*.pyc
*.log
*.log.gz
*.stdout
*.stderr
# End generated operational output.
